# Settings for the hosted (Vercel + Turso) deployment.
#
# On Vercel: add these in Project → Settings → Environment Variables (Production and Preview
# get different values). Locally: copy this file to .env.staging and/or .env.production and fill
# it in; the data scripts read it with --target staging / --target production, e.g.
#   npm run migrate -- --target staging
# `npm run dev` never reads these files: it always uses the local database in server/data/.
# The .env.* files are git-ignored — never commit them.

# Turso database (Turso dashboard → your database → Connect)
TURSO_DATABASE_URL=libsql://matchmehub-staging-<your-org>.turso.io
TURSO_AUTH_TOKEN=

# Vercel Blob, a PRIVATE store (Vercel → Storage → your store → .env.local tab)
BLOB_READ_WRITE_TOKEN=

# The site's public address, used in emailed links (no trailing slash)
APP_URL=https://matchmehub.example.com

# Email (SMTP) — required on Vercel, otherwise password reset and invitation emails aren't sent
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM=MatchMeHub <hello@matchmehub.example.com>

# Protects the daily clean-up job (any long random string; Vercel Cron sends it automatically)
CRON_SECRET=
